    {
      "id": "0a15bfdd-dac9-49a2-a6b8-e7caf0cd0c1b",
      "name": "Data Export",
      "description": {
        "content": "Retrieve exported session data files from storage buckets.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8530a228-4747-47df-9f31-5141726a174b",
          "name": "List exported session data files",
          "request": {
            "name": "List exported session data files",
            "description": {
              "content": "Returns a paginated list of exported session data files. Each session produces a single JSON Lines file when the session completes, which is defined as no new data being received for over an hour. Use the cursor from the response to retrieve the next page of results.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "orgs",
                ":orgId",
                "apps",
                ":appId",
                "data-export",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Cursor from a previous response to retrieve the next page of newer sessions. Treat this value as a string even though it may appear numeric."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of session export records to return per page. Default is 10, maximum is 100."
                },
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<string>",
                  "description": "Unix timestamp in milliseconds to start retrieving sessions from."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "orgId",
                  "description": "(Required) The organization identifier found in the LogRocket dashboard URL."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "appId",
                  "description": "(Required) The application or project identifier found in the LogRocket dashboard URL."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
